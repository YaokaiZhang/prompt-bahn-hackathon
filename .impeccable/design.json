    {
      "name": "Route Summary",
      "kind": "custom",
      "refersTo": "inset-block",
      "description": "The route in one birch pill: orange pickup pin, teal progress, red delivery pin.",
      "html": "<div class=\"ds-route\"><span class=\"ds-end\"><i class=\"ds-pin\" style=\"background:#fd6a31;color:#fd6a31\"></i>Hamburg</span><span class=\"ds-line\" style=\"--progress:58%\"></span><span class=\"ds-end\"><i class=\"ds-pin\" style=\"background:#fd4a61;color:#fd4a61\"></i>Lyon</span><span class=\"ds-km\">1,104 km</span></div>",
      "css": ":root{--birch:#fffef7;--sand-50:#f1eee6;--sand-100:#e2ded4;--sand-200:#ccc6ba;--grey-500:#8a7f6b;--muted:#685f4f;--brown:#5a5346;--body:#2a2721;--ink:#12110e;--ease:cubic-bezier(0.22,1,0.36,1)}.ds-route{font-family:Figtree,'Duplet Open',system-ui,sans-serif;font-feature-settings:'tnum';display:flex;align-items:center;gap:12px;padding:12px 18px;border-radius:999px;background:var(--birch,#fffef7);font-size:15px;font-weight:600;color:var(--ink,#12110e);box-shadow:inset 0 0 0 1px var(--sand-100,#e2ded4)}.ds-end{display:inline-flex;align-items:center;gap:10px;white-space:nowrap}.ds-pin{width:12px;height:12px;border-radius:50%;box-shadow:0 0 0 3px #fffef7,0 0 0 4px currentColor}.ds-line{position:relative;flex:1;min-width:40px;height:4px;border-radius:2px;background:var(--sand-200,#ccc6ba)}.ds-line::after{content:'';position:absolute;inset:0 auto 0 0;width:var(--progress,0%);border-radius:2px;background:#43afc1;animation:ds-fill .7s cubic-bezier(0.22,1,0.36,1) both}@keyframes ds-fill{from{width:0}}.ds-km{font-weight:500;color:var(--muted,#685f4f);white-space:nowrap}@media (prefers-reduced-motion:reduce){.ds-line::after{animation:none}}"
