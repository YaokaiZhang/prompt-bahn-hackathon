  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Asphalt pill for the one main action, such as Open order.",
      "html": "<button class=\"ds-btn-primary\">Open order</button>",
      "css": ":root{--birch:#fffef7;--sand-50:#f1eee6;--sand-100:#e2ded4;--sand-200:#ccc6ba;--grey-500:#8a7f6b;--muted:#685f4f;--brown:#5a5346;--body:#2a2721;--ink:#12110e;--ease:cubic-bezier(0.22,1,0.36,1)}.ds-btn-primary{font-family:Figtree,'Duplet Open',system-ui,sans-serif;font-feature-settings:'tnum';display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 22px;border:0;border-radius:999px;background:var(--ink,#12110e);color:var(--birch,#fffef7);font-size:16px;font-weight:600;cursor:pointer;transition:background-color .18s cubic-bezier(0.22,1,0.36,1)}.ds-btn-primary:hover{background:var(--body,#2a2721)}.ds-btn-primary:focus-visible{outline:3px solid var(--grey-500,#8a7f6b);outline-offset:2px}"
    },
    {
      "name": "Tertiary Button",
      "kind": "button",
      "refersTo": "button-tertiary",
      "description": "Sand pill for secondary actions.",
      "html": "<button class=\"ds-btn-tertiary\">Next order</button>",
      "css": ":root{--birch:#fffef7;--sand-50:#f1eee6;--sand-100:#e2ded4;--sand-200:#ccc6ba;--grey-500:#8a7f6b;--muted:#685f4f;--brown:#5a5346;--body:#2a2721;--ink:#12110e;--ease:cubic-bezier(0.22,1,0.36,1)}.ds-btn-tertiary{font-family:Figtree,'Duplet Open',system-ui,sans-serif;font-feature-settings:'tnum';display:inline-flex;align-items:center;height:48px;padding:0 22px;border:0;border-radius:999px;background:var(--sand-100,#e2ded4);color:var(--ink,#12110e);font-size:16px;font-weight:600;cursor:pointer;transition:background-color .18s cubic-bezier(0.22,1,0.36,1)}.ds-btn-tertiary:hover{background:var(--sand-200,#ccc6ba)}.ds-btn-tertiary:focus-visible{outline:3px solid var(--grey-500,#8a7f6b);outline-offset:2px}.ds-btn-tertiary:disabled{background:var(--sand-50,#f1eee6);color:var(--grey-500,#8a7f6b);cursor:default}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Pill search field on sand that turns birch with an ink ring on focus.",
      "html": "<label class=\"ds-field\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"7\" cy=\"7\" r=\"4.5\"/><path d=\"m10.5 10.5 3 3\"/></svg><input placeholder=\"Search orders, cars, customers\"></label>",
      "css": ":root{--birch:#fffef7;--sand-50:#f1eee6;--sand-100:#e2ded4;--sand-200:#ccc6ba;--grey-500:#8a7f6b;--muted:#685f4f;--brown:#5a5346;--body:#2a2721;--ink:#12110e;--ease:cubic-bezier(0.22,1,0.36,1)}.ds-field{font-family:Figtree,'Duplet Open',system-ui,sans-serif;font-feature-settings:'tnum';display:flex;align-items:center;gap:10px;height:48px;padding:0 18px;border-radius:999px;background:var(--sand-50,#f1eee6);color:var(--muted,#685f4f);transition:background-color .18s cubic-bezier(0.22,1,0.36,1),box-shadow .18s cubic-bezier(0.22,1,0.36,1)}.ds-field:hover{background:var(--birch,#fffef7);box-shadow:inset 0 0 0 1px var(--sand-200,#ccc6ba)}.ds-field:focus-within{background:var(--birch,#fffef7);box-shadow:inset 0 0 0 2px var(--ink,#12110e);color:var(--ink,#12110e)}.ds-field input{width:100%;border:0;outline:0;background:transparent;font:inherit;font-size:15px;color:var(--ink,#12110e)}.ds-field input::placeholder{color:var(--muted,#685f4f)}"
    },
    {
      "name": "Pill Navigation",
      "kind": "nav",
      "refersTo": "nav-track",
      "description": "Pill links in a sand track; the current page is a lifted birch pill.",
      "html": "<nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Orders</a><a href=\"#\">Inbox</a><a href=\"#\">Customers</a><a href=\"#\">Drivers</a><a href=\"#\">Places</a></nav>",
      "css": ":root{--birch:#fffef7;--sand-50:#f1eee6;--sand-100:#e2ded4;--sand-200:#ccc6ba;--grey-500:#8a7f6b;--muted:#685f4f;--brown:#5a5346;--body:#2a2721;--ink:#12110e;--ease:cubic-bezier(0.22,1,0.36,1)}.ds-nav{font-family:Figtree,'Duplet Open',system-ui,sans-serif;font-feature-settings:'tnum';display:inline-flex;gap:2px;padding:4px;border-radius:999px;background:var(--sand-50,#f1eee6)}.ds-nav a{display:flex;align-items:center;height:40px;padding:0 18px;border-radius:999px;font-size:15px;font-weight:600;color:var(--brown,#5a5346);text-decoration:none;transition:background-color .18s cubic-bezier(0.22,1,0.36,1),color .18s cubic-bezier(0.22,1,0.36,1)}.ds-nav a:hover{background:var(--sand-100,#e2ded4);color:var(--ink,#12110e)}.ds-nav a:focus-visible{outline:3px solid var(--grey-500,#8a7f6b);outline-offset:2px}.ds-nav a[aria-current=page]{background:var(--birch,#fffef7);color:var(--ink,#12110e);box-shadow:0 1px 3px rgba(18,17,14,.1)}"
    },
    {
      "name": "Stage Filters",
      "kind": "chip",
      "refersTo": "filter",
      "description": "Stage filters with counts; pressed inverts to asphalt, Needs action rests in red wash.",
      "html": "<div class=\"ds-filters\"><button class=\"ds-filter\" aria-pressed=\"true\">Needs action <em>7</em></button><button class=\"ds-filter ds-need\" aria-pressed=\"false\">Needs action <em>7</em></button><button class=\"ds-filter\" aria-pressed=\"false\"><i class=\"ds-dot\" style=\"background:#43afc1\"></i>Moving <em>12</em></button><button class=\"ds-filter\" aria-pressed=\"false\"><i class=\"ds-dot\" style=\"background:#29af77\"></i>Delivered <em>31</em></button></div>",
      "css": ":root{--birch:#fffef7;--sand-50:#f1eee6;--sand-100:#e2ded4;--sand-200:#ccc6ba;--grey-500:#8a7f6b;--muted:#685f4f;--brown:#5a5346;--body:#2a2721;--ink:#12110e;--ease:cubic-bezier(0.22,1,0.36,1)}.ds-filters{font-family:Figtree,'Duplet Open',system-ui,sans-serif;font-feature-settings:'tnum';display:flex;flex-wrap:wrap;gap:4px}.ds-filter{font:inherit;display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 11px;border:0;border-radius:999px;background:var(--sand-50,#f1eee6);font-size:14px;font-weight:600;color:var(--brown,#5a5346);cursor:pointer;transition:background-color .18s cubic-bezier(0.22,1,0.36,1),color .18s cubic-bezier(0.22,1,0.36,1)}.ds-filter:hover{background:var(--sand-100,#e2ded4);color:var(--ink,#12110e)}.ds-filter:focus-visible{outline:3px solid var(--grey-500,#8a7f6b);outline-offset:2px}.ds-filter em{font-style:normal;font-weight:500;color:var(--muted,#685f4f)}.ds-filter[aria-pressed=true]{background:var(--ink,#12110e);color:var(--birch,#fffef7)}.ds-filter[aria-pressed=true] em{color:var(--sand-200,#ccc6ba)}.ds-filter.ds-need[aria-pressed=false],.ds-filter.ds-need[aria-pressed=false] em{background:#ffe8ec;color:#a13342}.ds-dot{width:8px;height:8px;border-radius:50%}"
    },
    {
      "name": "Status Pills",
      "kind": "chip",
      "refersTo": "pill",
      "description": "Small pills; tones use the signal wash with the signal ink.",
      "html": "<div class=\"ds-pills\"><span class=\"ds-pill\"><i class=\"ds-dot\" style=\"background:#43afc1\"></i>Moving</span><span class=\"ds-pill ds-danger\">Delivery at risk</span><span class=\"ds-pill ds-warn\">Open claim</span><span class=\"ds-pill ds-ok\">Contact confirmed</span></div>",
