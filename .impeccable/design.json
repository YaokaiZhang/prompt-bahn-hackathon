      "refersTo": "queue-card",
      "description": "One order in the queue; the selected card inverts to asphalt.",
      "html": "<div class=\"ds-queue\"><a class=\"ds-qcard\" href=\"#\" aria-current=\"true\"><span class=\"ds-top\"><b>Volkswagen ID.4</b><span class=\"ds-stage\"><i style=\"background:#fffef7\"></i>Booked</span></span><span class=\"ds-meta\">BX-24117 · Nordwind Leasing</span><span class=\"ds-meta\">Hamburg → Lyon · pickup Tue 08:00–10:00</span><span class=\"ds-why ds-why-danger\">Driver not confirmed</span></a><a class=\"ds-qcard\" href=\"#\"><span class=\"ds-top\"><b>Škoda Enyaq</b><span class=\"ds-stage\"><i style=\"background:#43afc1\"></i>Moving</span></span><span class=\"ds-meta\">BX-24102 · Fahrwerk GmbH</span><span class=\"ds-meta\">Munich → Milan · delivery Wed 14:00</span><span class=\"ds-why ds-why-warn\">ETA after the delivery window</span></a></div>",
      "css": ":root{--birch:#fffef7;--sand-50:#f1eee6;--sand-100:#e2ded4;--sand-200:#ccc6ba;--grey-500:#8a7f6b;--muted:#685f4f;--brown:#5a5346;--body:#2a2721;--ink:#12110e;--ease:cubic-bezier(0.22,1,0.36,1)}.ds-queue{font-family:Figtree,'Duplet Open',system-ui,sans-serif;font-feature-settings:'tnum';display:grid;gap:8px;max-width:440px}.ds-qcard{display:grid;gap:3px;padding:14px 18px 15px;border-radius:18px;background:var(--sand-50,#f1eee6);color:var(--ink,#12110e);text-decoration:none;transition:background-color .2s cubic-bezier(0.22,1,0.36,1),color .2s cubic-bezier(0.22,1,0.36,1)}.ds-qcard:hover{background:var(--sand-100,#e2ded4)}.ds-qcard:focus-visible{outline:3px solid var(--grey-500,#8a7f6b);outline-offset:2px}.ds-top{display:flex;align-items:baseline;gap:10px}.ds-top b{flex:1;font-size:16px;font-weight:700}.ds-stage{display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:600;color:var(--muted,#685f4f)}.ds-stage i{width:8px;height:8px;border-radius:50%;background:#12110e}.ds-meta{font-size:14px;color:var(--muted,#685f4f)}.ds-why{margin-top:5px;font-size:14px;font-weight:600}.ds-why-danger{color:#a13342}.ds-why-warn{color:#a14623}.ds-qcard[aria-current=true]{background:var(--ink,#12110e);color:var(--birch,#fffef7)}.ds-qcard[aria-current=true] .ds-meta,.ds-qcard[aria-current=true] .ds-stage{color:var(--sand-200,#ccc6ba)}.ds-qcard[aria-current=true] .ds-why-danger{color:#ff8e9d}.ds-qcard[aria-current=true] .ds-why-warn{color:#ffa27e}"
