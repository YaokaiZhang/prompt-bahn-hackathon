DATABASE_URL=postgres://controlroom:controlroom@localhost:5438/controlroom
S3_ENDPOINT=http://127.0.0.1:9009
S3_ACCESS_KEY_ID=controlroom
S3_SECRET_ACCESS_KEY=controlroom-local-only
S3_BUCKET=controlroom-attachments
ANTHROPIC_API_KEY=YOUR_API_KEY
# Phone audio (speech to text, text to speech): Anthropic has no speech models. Azure AI Speech;
# the region is the one in the resource's endpoint (https://<region>.api.cognitive.microsoft.com/).
AZURE_SPEECH_KEY=YOUR_AZURE_KEY
AZURE_SPEECH_REGION=germanywestcentral
# AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural
# Optional: OpenRouter's audio-in, audio-out model for tier 2 (and speech, when Azure is not set).
# OPENROUTER_API_KEY=YOUR_API_KEY
# Engine tests against Postgres (optional): a separate, seeded database with the schema pushed. Tests reset its cr_ tables.
# TEST_DATABASE_URL=postgres://controlroom:controlroom@localhost:5438/controlroom_test
